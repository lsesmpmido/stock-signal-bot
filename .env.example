# このファイルはテンプレート（Git 管理対象）。本物の値は書かないこと。
# cp .env.example .env でコピーして、.env（Git 管理外）に値を書く。

# ---- Discord ----
DISCORD_TOKEN=
# チャンネル ID（Discord の開発者モードで右クリック →「ID をコピー」）
DISCORD_CHANNEL_PROPOSAL=
DISCORD_CHANNEL_SIGNAL=
# 任意: 定番レポート・AI の売買の通知を投稿するチャンネル ID（未設定なら売買シグナル用のチャンネル）
DISCORD_CHANNEL_REPORT=
# 任意: サーバー ID を入れるとスラッシュコマンドが即座に反映される
DISCORD_GUILD_ID=

# ---- Jev (TypeSafe AI) ----
JEV_API_KEY=

# ---- PostgreSQL ----
# 例: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ---- その他 ----
# 任意: ヘルスチェック用サーバーのポート（既定 8080）。実行環境が自動で設定する場合は書かない
# PORT=8080
